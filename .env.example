D# Resend Email Delivery Configuration
# 1. Obtain your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_actual_api_key

# 2. Designated inbox where you want to receive portfolio messages (your personal email)
CONTACT_EMAIL=your_verified_receiving_email@example.com

# 3. Verified sender email address on Resend
# For testing: onboarding@resend.dev (sends to the email registered with your Resend account)
# For production: contact@yourverifieddomain.com (once your custom domain is verified in Resend)
FROM_EMAIL=your_verified_sender_address@example.com
